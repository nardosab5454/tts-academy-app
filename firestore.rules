rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid in ['admin_1', 'admin_spike', 'admin_abebe'] ||
        (request.auth.token.email != null && (
          request.auth.token.email in ['spikenarrd@gmail.com', 'abebewottee@gmail.com'] ||
          request.auth.token.email.matches('.*admin.*')
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.email is string && data.email.size() > 3 && data.email.size() <= 150 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100;
    }

    function isValidAnnouncement(data) {
      return data.id is string && isValidId(data.id) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200;
    }

    function isValidCourse(data) {
      return data.id is string && isValidId(data.id) &&
             data.code is string && data.code.size() > 0 && data.code.size() <= 50 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200;
    }

    function isValidQuestion(data) {
      return data.id is string && isValidId(data.id) &&
             data.courseId is string && data.courseId.size() > 0 &&
             data.questionText is string && data.questionText.size() > 0;
    }

    function isValidNote(data) {
      return data.id is string && isValidId(data.id) &&
             data.courseId is string && data.courseId.size() > 0 &&
             data.title is string && data.title.size() > 0;
    }

    function isValidPastExam(data) {
      return data.id is string && isValidId(data.id) &&
             data.courseId is string && data.courseId.size() > 0 &&
             data.title is string && data.title.size() > 0;
    }

    function isValidAccessCode(data) {
      return data.code is string && data.code.size() == 6;
    }

    // User profiles & student registrations
    // Public read so admin dashboard can list all registered students across devices
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if isAdmin();

      // Quiz attempts subcollection
      match /quiz_attempts/{attemptId} {
        allow read, write: if true;
      }

      // Bookmarks subcollection
      match /bookmarks/{bookmarkId} {
        allow read, write: if true;
      }

      // Personal notes subcollection
      match /notes/{noteId} {
        allow read, write: if true;
      }
    }

    // Global announcements (public read, real-time sync across all devices)
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Courses (public read, real-time sync across all devices)
    match /courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Questions & past exam questions (public read, real-time sync across all devices)
    match /questions/{questionId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Official revision notes (public read, real-time sync across all devices)
    match /notes/{noteId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Past examination documents (public read, real-time sync across all devices)
    match /past_exams/{examId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 6-digit access codes for unlock verification
    match /access_codes/{code} {
      allow read, write: if true;
    }
  }
}
