rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid in ['admin_1', 'admin_spike', 'admin_abebe'] ||
        (request.auth.token.email != null && (
          request.auth.token.email in ['spikenarrd@gmail.com', 'abebewottee@gmail.com'] ||
          request.auth.token.email.matches('.*admin.*')
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.email is string && data.email.size() > 3 && data.email.size() <= 150 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100;
    }

    function isValidAnnouncement(data) {
      return data.id is string && isValidId(data.id) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200;
    }

    function isValidCourse(data) {
      return data.id is string && isValidId(data.id) &&
             data.code is string && data.code.size() > 0 && data.code.size() <= 50 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200;
    }

    function isValidTopic(data) {
      return data.id is string && isValidId(data.id) &&
             data.courseId is string && data.courseId.size() > 0 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200;
    }

    function isValidQuestion(data) {
      return data.id is string && isValidId(data.id) &&
             data.courseId is string && data.courseId.size() > 0 &&
             data.questionText is string && data.questionText.size() > 0;
    }

    function isValidNote(data) {
      return data.id is string && isValidId(data.id) &&
             data.courseId is string && data.courseId.size() > 0 &&
             data.title is string && data.title.size() > 0;
    }

    function isValidPastExam(data) {
      return data.id is string && isValidId(data.id) &&
             data.courseId is string && data.courseId.size() > 0 &&
             data.title is string && data.title.size() > 0;
    }

    // User profiles & student registrations (strict owner/admin zero-trust isolation)
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if (isOwner(userId) && isValidUserProfile(incoming()) && (!('role' in incoming()) || incoming().role == 'STUDENT' || isAdmin())) || isAdmin();
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !incoming().diff(resource.data).affectedKeys().hasAny(['role'])
      );
      allow delete: if isAdmin();

      // Quiz attempts subcollection
      match /quiz_attempts/{attemptId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Bookmarks subcollection
      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Personal notes subcollection
      match /notes/{noteId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Global announcements (public read, admin write)
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidAnnouncement(incoming());
      allow delete: if isAdmin();
    }

    // Courses (public read across devices, admin write)
    match /courses/{courseId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidCourse(incoming());
      allow delete: if isAdmin();
    }

    // Course Sections / Topics (public read across devices, admin write)
    match /topics/{topicId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidTopic(incoming());
      allow delete: if isAdmin();
    }

    // Questions & past exam questions (public read across devices, admin write)
    match /questions/{questionId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidQuestion(incoming());
      allow delete: if isAdmin();
    }

    // Official revision notes (public read across devices, admin write)
    match /notes/{noteId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidNote(incoming());
      allow delete: if isAdmin();
    }

    // Past examination documents (public read across devices, admin write)
    match /past_exams/{examId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidPastExam(incoming());
      allow delete: if isAdmin();
    }

    // 6-digit access codes for unlock verification
    match /access_codes/{code} {
      allow get: if isSignedIn();
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.isRedeemed == false &&
        incoming().isRedeemed == true &&
        incoming().redeemedByUserId == request.auth.uid
      );
    }
  }
}
