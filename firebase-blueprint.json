{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile containing academic details, role, university, and premium access status",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique user ID matching auth UID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Student or educator email"
        },
        "name": {
          "type": "string",
          "description": "Display name of user"
        },
        "role": {
          "type": "string",
          "enum": ["STUDENT", "ADMIN", "SUPER_ADMIN"],
          "description": "User access role"
        },
        "department": {
          "type": "string",
          "description": "University or department name"
        },
        "studentId": {
          "type": "string",
          "description": "Student matric ID"
        },
        "isPremium": {
          "type": "boolean",
          "description": "Account unlocked status"
        },
        "activationCode": {
          "type": "string",
          "description": "6-character redeemed activation code"
        },
        "questionsAnsweredCount": {
          "type": "integer",
          "description": "Total practice questions answered"
        },
        "correctAnswersCount": {
          "type": "integer",
          "description": "Total correct answers"
        },
        "enrolledCourses": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Course IDs user is enrolled in"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp via serverTimestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update timestamp via serverTimestamp"
        }
      },
      "required": ["userId", "email", "name", "role", "isPremium", "createdAt"]
    },
    "AdminInvite": {
      "title": "AdminInvite",
      "description": "Pre-authorized admin email promotion record resolved on Google Sign-In",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "department": { "type": "string" },
        "invitedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "department", "invitedBy", "createdAt", "updatedAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Campus and curriculum announcement broadcast to all users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "message": { "type": "string" },
        "category": { "type": "string" },
        "author": { "type": "string" },
        "isUrgent": { "type": "boolean" },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "content", "isUrgent", "isPublished", "createdAt"]
    },
    "Course": {
      "title": "Course",
      "description": "University freshman course",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "iconName": { "type": "string" },
        "totalQuestions": { "type": "integer" },
        "totalNotes": { "type": "integer" },
        "isPublished": { "type": "boolean" },
        "orderIndex": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "code", "title", "category", "isPublished", "createdAt"]
    },
    "Topic": {
      "title": "Topic",
      "description": "Course section or topic",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "orderIndex": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "courseId", "title", "orderIndex", "createdAt"]
    },
    "Question": {
      "title": "Question",
      "description": "Curriculum multiple choice question with explanation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "topicId": { "type": "string" },
        "questionText": { "type": "string" },
        "optionA": { "type": "string" },
        "optionB": { "type": "string" },
        "optionC": { "type": "string" },
        "optionD": { "type": "string" },
        "correctAnswer": { "type": "string", "enum": ["A", "B", "C", "D"] },
        "explanationGeneral": { "type": "string" },
        "explanationA": { "type": "string" },
        "explanationB": { "type": "string" },
        "explanationC": { "type": "string" },
        "explanationD": { "type": "string" },
        "difficulty": { "type": "string" },
        "isPastExam": { "type": "boolean" },
        "examYear": { "type": "string" },
        "examType": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "courseId", "topicId", "questionText", "optionA", "optionB", "correctAnswer", "createdAt"]
    },
    "RevisionNote": {
      "title": "RevisionNote",
      "description": "Official revision and summary note for a course",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "topicId": { "type": "string" },
        "title": { "type": "string" },
        "chapterNumber": { "type": "integer" },
        "summary": { "type": "string" },
        "keyFormulas": { "type": "string" },
        "contentMarkdown": { "type": "string" },
        "content": { "type": "string" },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "courseId", "topicId", "title", "chapterNumber", "contentMarkdown", "isPublished", "createdAt"]
    },
    "PastExam": {
      "title": "PastExam",
      "description": "Past national / university examination paper",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "university": { "type": "string" },
        "academicYear": { "type": "string" },
        "semester": { "type": "string" },
        "examType": { "type": "string" },
        "title": { "type": "string" },
        "instructions": { "type": "string" },
        "totalQuestions": { "type": "integer" },
        "durationMinutes": { "type": "integer" },
        "isDigitized": { "type": "boolean" },
        "isVerified": { "type": "boolean" },
        "documentSummary": { "type": "string" },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "courseId", "university", "academicYear", "examType", "title", "isPublished", "createdAt"]
    },
    "AccessCode": {
      "title": "AccessCode",
      "description": "6-character single-use access code for account unlock",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "createdByAdminId": { "type": "string" },
        "isRedeemed": { "type": "boolean" },
        "redeemedByUserId": { "type": "string" },
        "redeemedByEmail": { "type": "string" },
        "redeemedAt": { "type": "string", "format": "date-time" },
        "note": { "type": "string" }
      },
      "required": ["code", "createdAt", "expiresAt", "createdByAdminId", "isRedeemed", "note"]
    },
    "QuizAttempt": {
      "title": "QuizAttempt",
      "description": "Recorded quiz test score and performance for a student",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "courseId": { "type": "string" },
        "topicId": { "type": "string" },
        "score": { "type": "integer" },
        "totalQuestions": { "type": "integer" },
        "percentage": { "type": "integer" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "courseId", "score", "totalQuestions", "percentage", "completedAt"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "Saved question bookmark for later review",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "questionId": { "type": "string" },
        "courseId": { "type": "string" },
        "topicId": { "type": "string" },
        "savedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "questionId", "courseId", "savedAt"]
    },
    "UserStudyNote": {
      "title": "UserStudyNote",
      "description": "Personal study note created by a student",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "courseId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "courseId", "title", "content", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles scoped by user ID"
    },
    "/users/{userId}/quiz_attempts/{attemptId}": {
      "schema": "QuizAttempt",
      "description": "Quiz attempts for a student"
    },
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": "Bookmark",
      "description": "Saved question bookmarks for a student"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": "UserStudyNote",
      "description": "Personal study notes created by a student"
    },
    "/admin_invites/{inviteEmail}": {
      "schema": "AdminInvite",
      "description": "Admin email invites for granting admin access before first login"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Global announcements broadcast across devices"
    },
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "University courses synced across all devices"
    },
    "/topics/{topicId}": {
      "schema": "Topic",
      "description": "Course sections/topics synced across all devices"
    },
    "/questions/{questionId}": {
      "schema": "Question",
      "description": "Curriculum questions and past exam questions"
    },
    "/notes/{noteId}": {
      "schema": "RevisionNote",
      "description": "Course revision notes synced across all devices"
    },
    "/past_exams/{examId}": {
      "schema": "PastExam",
      "description": "Past examination documents and test sets"
    },
    "/access_codes/{code}": {
      "schema": "AccessCode",
      "description": "Access codes for cloud-synced unlock verification"
    }
  }
}
